{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script --no-config --managed-python \"${CLAUDE_PLUGIN_ROOT}/hooks/h1.py\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script --no-config --managed-python \"${CLAUDE_PLUGIN_ROOT}/hooks/h0.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "uv run --script --no-config --managed-python \"${CLAUDE_PLUGIN_ROOT}/hooks/sg01.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "uv run --script --no-config --managed-python \"${CLAUDE_PLUGIN_ROOT}/hooks/h2.py\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script --no-config --managed-python \"${CLAUDE_PLUGIN_ROOT}/hooks/bash_note.py\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "uv run --script --no-config --managed-python \"${CLAUDE_PLUGIN_ROOT}/hooks/sg01_note.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
