{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/h0.py\"", "onFailure": "block"},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/h2.py\"", "onFailure": "block"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash_note.py\"", "onFailure": "block"}
        ]
      }
    ]
  }
}
