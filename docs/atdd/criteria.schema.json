          "additionalProperties": false,
          "required": [
            "channel",
            "wrong",
            "right",
            "prevent"
          ],
          "properties": {
            "channel": {
              "enum": [
                "stdout",
                "stderr",
                "hook_output",
                "fact",
                "run_report",
                "issue_comment",
                "tool_result",
                "sarif"
              ]
            },
            "wrong": {
              "type": "string",
              "minLength": 1
            },
            "right": {
              "type": "string",
              "minLength": 1
            },
            "prevent": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "lines": {
          "description": "The non-empty lines of a channel, counted or all matched against a pattern.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "pattern"
          ],
          "properties": {
            "channel": {
              "enum": [
                "stdout"
              ]
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "enum": [
                "eq",
                "ge",
                "le"
              ]
            },
            "every": {
              "type": "boolean"
            }
          },
          "anyOf": [
            {
              "required": [
                "count"
              ]
            },
            {
              "required": [
                "every"
              ]
            }
          ],
          "allOf": [
            {
              "if": {
                "required": [
                  "count"
                ]
              },
              "then": {
                "required": [
                  "op"
                ]
              }
            }
          ]
        },
        "output_contains": {
          "description": "A channel carries an exact text.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "text"
          ],
          "properties": {
            "channel": {
              "enum": [
                "stdout",
