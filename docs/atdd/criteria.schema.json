        "refused": {
          "description": "A refusal the spec allows (an order step, a launch precondition, a protected path, a bounded list or a lock) that teaches (P5): the step is not done and the message names what is wrong, the right way and the prevention. A failed validation is not a refusal: use schema_valid with valid false plus teaching.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "wrong",
            "right",
            "prevent"
          ],
          "properties": {
            "by": {
              "enum": [
                "hook",
                "sandbox",
                "file_tools",
                "program",
                "launch"
              ]
