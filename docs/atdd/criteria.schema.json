            "wrong": {
              "type": "string",
              "minLength": 1
            },
            "right": {
              "type": "string",
              "minLength": 1
            },
            "prevent": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "teaching": {
          "description": "A message that is not a refusal (a fact, note, unmet result or report line) teaches what is wrong, the right way and the prevention.",
