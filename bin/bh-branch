#!/usr/bin/env python3
"""Point bh/<item> at a builder's commit; deterministic, no agent.

A builder runs in an isolated worktree where it cannot move branches, so it returns its
commit sha and this tool, run from the main checkout, sets `refs/heads/bh/<item>` to it.
The commit must exist and be new (not in HEAD); its edits to plan or protected paths are not
judged here (the measurer ignores and lists them). The branch is created or fast-forwarded,
never moved otherwise. Prints {ok, item, branch, ref, previous} or {ok: false, error}.
Exit 0, or 2 when refused.

  bh-branch --config .brick-harness/config.json --item ID --ref SHA
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness" / "lib"))
from bhcore import Config, HarnessError, set_branch  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="bh-branch", description=__doc__.splitlines()[0])
    ap.add_argument("--config", default=".brick-harness/config.json")
    ap.add_argument("--item", required=True)
    ap.add_argument("--ref", required=True)
    a = ap.parse_args()
    try:
        print(json.dumps(set_branch(Config(a.config), a.item, a.ref)))
    except HarnessError as e:
        print(json.dumps({"ok": False, "item": a.item, "error": str(e)}))
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
