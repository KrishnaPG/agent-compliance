#!/usr/bin/env python3
"""Merge every met-unmerged candidate into the current branch; deterministic, no agent.

Reads the refs to merge from the scoreboard (never from arguments): each item the measurer
found met at a ref that is not yet in HEAD, in build order, merged with `git merge --no-ff`.
A conflict only in the catalogue is resolved by a schema-checked JSON union. Any other
conflict aborts that merge and records the item as `conflict` with the paths, so the next
build starts it again from HEAD. Prints {merged, conflicts, remeasure, head}: `remeasure`
lists the merged items and their dependents, to measure at HEAD. Exit 0, or 2 on error
(a merge in progress, uncommitted plan files, not a repository).

  bh-merge --config .brick-harness/config.json
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness" / "lib"))
from bhcore import Config, HarnessError, merge_unmerged  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="bh-merge", description=__doc__.splitlines()[0])
    ap.add_argument("--config", default=".brick-harness/config.json")
    a = ap.parse_args()
    try:
        print(json.dumps(merge_unmerged(Config(a.config))))
    except HarnessError as e:
        print(json.dumps({"error": str(e), "merged": [], "conflicts": [], "remeasure": []}))
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
