#!/usr/bin/env python3
"""Spec gap report: mechanical checks plus findings added by a reviewer or the plan phase.

Recomputes the mechanical gaps, replaces earlier findings of --source with the ones read
from --add (a JSON list of gaps, or {"gaps": [...]}; "-" reads stdin), rejects findings
whose file:line evidence does not resolve (or whose quote is not on that line), and prints
the merged report with `received` and `accepted` counts. Writes the report
(JSON and markdown) only with --write. Exit 0, or 2 on error. Gaps are reported, never decided.

  bh-gaps --config .brick-harness/config.json [--source review --add FILE|-] [--write]
          [--unmet ITEM[:REASON] ...] [--brief]

With --source cycle every item not met gets a gap: the --unmet ones with their reason, the
rest "not-attempted"; "stuck" lists them capped at SUMMARY_CAP ("stuck_more").
A target source '<ref>: "<quote>"' is resolved through tracker.show here (never in
bh-state); unresolved is reported like a missing source. --brief leaves the full gap list
out of the printed report (it is in the written file).
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness" / "lib"))
from bhcore import Config, HarnessError, loads, merge_gaps  # noqa: E402
from bhtracker import gap_facts, parent_is_feature, show_resolver  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="bh-gaps", description=__doc__.splitlines()[0])
    ap.add_argument("--config", default=".brick-harness/config.json")
    ap.add_argument("--add", help="JSON file of findings, or - for stdin")
    ap.add_argument("--source", default="review", help="who found them: review, plan, ...")
    ap.add_argument("--write", action="store_true", help="write the report (default: print only)")
    ap.add_argument(
        "--unmet",
        nargs="*",
        default=[],
        metavar="ITEM",
        help="items still unmet after a cycle: one gap each, cited at its scoreboard entry",
    )
    ap.add_argument("--brief", action="store_true", help="print counts, not every gap")
    a = ap.parse_args()
    try:
        added = []
        if a.add:
            raw = sys.stdin.read() if a.add == "-" else Path(a.add).read_text()
            doc = loads(raw) if raw.strip() else []
            added = doc["gaps"] if isinstance(doc, dict) else doc
        cfg = Config(a.config)
        out = merge_gaps(
            cfg,
            added,
            a.source,
            a.write,
            a.unmet,
            show_resolver(cfg),
            lambda st, bricks: gap_facts(cfg, st, bricks),
            parent_is_feature(cfg),
        )
        if a.brief:
            out = {**{k: v for k, v in out.items() if k != "gaps"}, "gaps_total": len(out["gaps"])}
        print(json.dumps(out, sort_keys=True))
    except (HarnessError, OSError, ValueError, KeyError, TypeError) as e:
        print(json.dumps({"error": str(e), "gaps": []}))
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
