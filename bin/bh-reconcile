#!/usr/bin/env python3
"""Reconcile the tracker with the measured status: the only caller of close and reopen.

Run after the scoreboard commit at HEAD and before admission. For each item in the plan that
names tracker refs: an entry still open while the item is measured met at HEAD is closed (reason:
the sha and targets digest, acting as the claim holder); an entry closed while the item is not
met at HEAD is reopened. Entries of no admitted item are never touched; nothing is deleted
(a missing ref is the fact ref-missing); writes happen only on a mismatch, so a repeat is a
no-op. Without --write it lists the mismatches. Exit 0, or 2 on error.

  bh-reconcile --config .brick-harness/config.json [--write]
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness" / "lib"))
from bhtracker import Config, HarnessError, reconcile  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="bh-reconcile", description=__doc__.splitlines()[0])
    ap.add_argument("--config", default=".brick-harness/config.json")
    ap.add_argument("--write", action="store_true", help="close and reopen (default: list only)")
    a = ap.parse_args()
    try:
        print(json.dumps(reconcile(Config(a.config), a.write), sort_keys=True))
    except (HarnessError, OSError, ValueError, KeyError, TypeError) as e:
        print(json.dumps({"error": str(e)}))
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
