#!/usr/bin/env -S uv run --script --managed-python
# /// script
# requires-python = "==3.14.*"
# dependencies = ["jsonschema==4.26.0", "junitparser==5.0.3", "packaging==26.4", "semver==3.1.1"]
# ///
"""Deterministic measurer: the only writer of the scoreboard.

Runs the configured test and bench commands for each item in a clean checkout of its ref,
compares raw numbers with the targets, records each result in the scoreboard as it lands, and prints the run as JSON. A result at HEAD is current; any other
ref is a candidate. Exit 0 when every measured item met its targets, 1 when any did not,
2 on a usage or config error or when a result could not be recorded (the results are
still printed).

  bh-measure --config .brick-harness/config.json [--item ID[@REF] ...] [--slot N]

One call runs env_setup, test and bench for each item, each bounded by commands.timeout_s.
Callers with a shell time limit measure one item per call.
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness" / "lib"))
from bhcore import Config, HarnessError, measure  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="bh-measure", description=__doc__.splitlines()[0])
    ap.add_argument("--config", default=".brick-harness/config.json")
    ap.add_argument(
        "--item",
        action="append",
        default=[],
        help="ID or ID@REF (default ref HEAD); repeat; default all items",
    )
    ap.add_argument("--slot", type=int, default=0)
    a = ap.parse_args()
    try:
        items = [(i.partition("@")[0], i.partition("@")[2] or "HEAD") for i in a.item]
        run = measure(Config(a.config), items, slot=a.slot)
    except HarnessError as e:
        print(json.dumps({"ok": False, "error": str(e), "items": {}}))
        return 2
    print(json.dumps(run, sort_keys=True))
    if run.get("error"):
        return 2
    return 0 if run["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
