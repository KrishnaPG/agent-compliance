#!/usr/bin/env python3
"""Write the harness state to a file and print a small summary of it.

Validates the config, lists files (harness-owned ones are creatable), item status from the
scoreboard (with the previous ref and unmet numbers of an item to rebuild), blocked items,
dependency waves, ready items, builder branches (bh/<item>), the plan commit, rendered
per-item commands, catalogue entries and duplicates, lockfile versions, the mechanical spec
gaps and counts. Exit 0 with no problems, 1 with problems, 2 when the config cannot be read
or a part is unknown.

  bh-state --config .brick-harness/config.json
  bh-state --config .brick-harness/config.json [--part KEY ... | --parts | --value KEY | --affected REF]

Big output never crosses an agent: the full state is written (atomically) to
``<measure_out>/state.json`` (the out directory is git-ignored) and the CLI prints
{"file", "head", "plan_head", "all_met", "counts": {status: n}, "ready", "ready_system",
"unmet", "unmet_more", "problems", ...}, each id list capped at limits.decision_items. Agents
read the file themselves (a path, a ``jq`` filter); nothing is re-read in slices or checked
against a checksum.

--part prints {KEY: value} for each KEY, --value the bare value of one KEY, --parts the part
names with a checksum of each, and --part pending --after ID / --part learning --after D-n
page their part: the read path of the workflows until they read the state file (wave 1b).
--affected prints the items a ref touches and everything depending on them.
"""

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "harness" / "lib"))
from bhcore import (  # noqa: E402
    Config,
    HarnessError,
    affected,
    checksum,
    learning_part,
    load_decisions,
    overlay_rules,
    pending_page,
    state,
    value_queue,
)


def summary(cfg: Config, s: dict) -> dict:
    """Write the full state to <measure_out>/state.json and return its small summary.

    Tools checked for the write: ``os.replace`` of a temp file in the same directory is the
    stdlib's atomic write; nothing else was needed.
    """
    out = cfg.file("measure_out")
    assert out is not None
    out.mkdir(parents=True, exist_ok=True)
    path = out / "state.json"
    tmp = path.with_name(f".state.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(s, sort_keys=True, separators=(",", ":")))
    os.replace(tmp, path)
    cap = cfg.limit("decision_items")
    unmet = [b["id"] for b in s["bricks"] if b["status"] != "met"]
    counts: dict[str, int] = {}
    for b in s["bricks"]:
        counts[b["status"]] = counts.get(b["status"], 0) + 1
    return {
        "file": str(path),
        "head": s["head"],
        "plan_head": s["plan_head"],
        "all_met": s["all_met"],
        "counts": counts,
        "ready": s["ready"][:cap],
        "ready_more": max(0, len(s["ready"]) - cap),
        "ready_system": s["ready_system"][:cap],
        "ready_system_more": max(0, len(s["ready_system"]) - cap),
        "unmet": unmet[:cap],
        "unmet_more": max(0, len(unmet) - cap),
        "gaps": len(s["gaps"]),
        "problems": s["problems"][:cap],
        "problems_more": max(0, len(s["problems"]) - cap),
    }


def main() -> int:
    ap = argparse.ArgumentParser(prog="bh-state", description=__doc__.splitlines()[0])
    ap.add_argument("--config", default=".brick-harness/config.json")
    ap.add_argument(
        "--part",
        action="append",
        default=[],
        help="print only these top-level keys (repeatable); keeps output small where a "
        "caller's tool shortens long output",
    )
    ap.add_argument(
        "--value",
        metavar="KEY",
        help="print only the bare JSON value of one part (no {KEY: ...} wrapper); same "
        "serialisation as --part, so its checksum equals the one --parts lists",
    )
    ap.add_argument("--parts", action="store_true", help="list the parts and their checksums")
    ap.add_argument("--after", metavar="ID", help="with --part pending: the page after item ID")
    ap.add_argument("--affected", metavar="REF", help="items REF touches, with dependents")
    a = ap.parse_args()
    try:
        cfg = Config(a.config)
        if a.affected:
            print(json.dumps({"affected": affected(cfg, a.affected)}))
            return 0
        s = state(cfg)
    except HarnessError as e:
        print(json.dumps({"problems": [str(e)], "config": None}))
        return 2
    if a.after is not None:
        if a.part not in (["pending"], ["learning"]):
            print(json.dumps({"problems": ["--after goes with --part pending or learning only"]}))
            return 2
        try:
            if a.part == ["pending"]:
                page = pending_page(
                    s["bricks"], value_queue(cfg, s), cfg.limit("decision_items"), a.after
                )
            else:
                page = learning_part(cfg, load_decisions(cfg), overlay_rules(cfg), a.after)
        except HarnessError as e:
            print(json.dumps({"problems": [str(e)]}))
            return 2
        print(json.dumps({a.part[0]: page}, sort_keys=True, separators=(",", ":")))
        return 0
    if a.parts:
        print(json.dumps({"parts": sorted(s), "checksums": {k: checksum(v) for k, v in s.items()}}))
        return 0
    if a.value is not None:
        if a.value not in s:
            print(json.dumps({"problems": [f"unknown part {a.value}"], "parts": sorted(s)}))
            return 2
        print(json.dumps(s[a.value], sort_keys=True, separators=(",", ":")))
        return 1 if s["problems"] else 0
    unknown = [k for k in a.part if k not in s]
    if unknown:
        print(json.dumps({"problems": [f"unknown part {k}" for k in unknown], "parts": sorted(s)}))
        return 2
    out = {k: s[k] for k in a.part} if a.part else summary(cfg, s)
    print(json.dumps(out, sort_keys=True, separators=(",", ":")))
    return 1 if s["problems"] else 0


if __name__ == "__main__":
    sys.exit(main())
