{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The JSON a bh command prints (fields named in docs/atdd/fields.yaml); d0 adds the other commands",
  "type": "object",
  "required": ["schema_version", "command"],
  "properties": {
    "schema_version": {"type": "string"},
    "command": {"enum": ["run", "measure", "check", "intake", "merge", "decide", "gaps", "owners", "metrics", "vet", "map"]},
    "packet_sha256": {"type": "string"},
    "checks_run": {"type": "array", "items": {"type": "string"}},
    "checks_missed": {"type": "array", "items": {"type": "string"}},
    "run_report": {"type": "string"},
    "config": {"type": "object"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["met", "unmet", "stuck", "not_checked"]},
          "out": {"type": "string"},
          "tier": {"enum": ["mechanical", "design-affecting"], "description": "the tier the item ran at: the packet's, raised by what the diff touched (R6)"},
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "status"],
              "properties": {"id": {"type": "string"}, "status": {"enum": ["met", "unmet"]}}
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "window", "value", "unit"],
        "properties": {
          "id": {"enum": ["change_failure_rate", "lead_time_for_changes", "tokens_per_met_slice", "measurer_rounds"]},
          "window": {"enum": ["current", "baseline"]},
          "value": {"type": "number"},
          "unit": {"enum": ["ratio", "hours", "tokens", "count"]}
        }
      }
    },
    "options": {"type": "array", "items": {"type": "object", "required": ["id", "targets", "rules"], "properties": {"id": {"type": "string"}, "targets": {"type": "array"}, "rules": {"type": "array", "items": {"type": "object", "required": ["id", "verdict"], "properties": {"id": {"type": "string"}, "verdict": {"enum": ["pass", "fail", "unknown"]}}}}}}},
    "recommended": {"type": "string"},
    "api_results": {"type": "array", "items": {"type": "object", "required": ["id", "body"], "additionalProperties": false, "properties": {"id": {"enum": ["scorecard", "deps.dev", "osv"]}, "body": {"type": "object"}}}},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "properties": {"kind": {"type": "string"}, "detail": {"type": "string"}, "item": {"type": "string"}, "message": {"type": "string"}}
      }
    }
  }
}
