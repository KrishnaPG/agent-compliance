{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packet.schema.json",
  "title": "work packet",
  "description": "The one contract for L3 (tests), L4 (build) and L5 (measure). Field names follow docs/atdd/fields.yaml. Planner-written fields state the goal and why, never the design: a field not listed here, such as a design field, is refused. The x-written-by annotation marks the planner-written fields: only these count toward sizing.packet_tokens; the program fills the rest.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "tier",
    "goal",
    "applies",
    "constraints",
    "acceptance",
    "verifier",
    "paved_road",
    "definition_of_done"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "version of this schema (Semantic Versioning 2.0.0)"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "the item id; names the packet file"
    },
    "parent_issue": {
      "type": "integer",
      "minimum": 1,
      "description": "tracker issue number of the item's parent, when the project has a tracker"
    },
    "kind": {
      "enum": [
        "slice",
        "defect"
      ],
      "default": "slice",
      "description": "slice, or defect for a fix of a recorded defect (a sub-issue under parent)"
    },
    "parent": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      ],
      "description": "defect packets only: the tracker issue number of the slice or decision the defect sits under, or the plan item id of the slice when it has no tracker issue"
    },
    "found_by": {
      "enum": [
        "planner",
        "judge",
        "proposer",
        "test_author",
        "builder",
        "reviewer",
        "measurer",
        "person"
      ],
      "description": "defect packets only: who found the defect; its regression row is written by that agent unless it is the builder, then by the test_author job"
    },
    "tier": {
      "enum": [
        "mechanical",
        "design-affecting"
      ],
      "description": "derived from declared paths and the diff (d5), never typed by a person"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "commander's intent: the intent and why, with no design",
      "x-written-by": "planner"
    },
    "applies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([GPR][0-9]+|QBC-[0-9]+)$",
            "x-written-by": "planner"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "copied verbatim from spec section 0"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "declared_paths"
      ],
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "x-written-by": "planner"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declared_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "x-written-by": "planner"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      },
      "description": "the acceptance criteria; the test author implements each as a plain test in the project's own framework, in verifier.acceptance_paths"
    },
    "verifier": {
      "type": "object",
      "required": [
        "acceptance_paths"
      ],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "item",
              "metric",
              "op",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "item": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "op": {
                "enum": [
                  ">=",
                  "<=",
                  "==",
                  "!=",
                  ">",
                  "<"
                ]
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "acceptance_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "paved_road": {
      "type": "object",
      "required": [
        "test_paths",
        "dependency_command",
        "check_command"
      ],
      "additionalProperties": false,
      "properties": {
        "test_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependency_command": {
          "type": "string"
        },
        "check_command": {
          "type": "string"
        }
      }
    },
    "definition_of_done": {
      "type": "string",
      "minLength": 1
    },
    "overflow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "file in the packet directory holding text moved out over the size cap"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "defect"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "parent",
          "found_by"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "parent"
              ]
            },
            {
              "required": [
                "found_by"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "traces_to",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+-AC\\d+$",
          "description": "<packet id>-AC<n>; the acceptance test's function name carries it (test_<id with - as _>...)"
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "traces_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "where the criterion comes from: a project document file:line (the build order's done-when line), or a G, P, R or QBC id"
        },
        "verification": {
          "enum": [
            "fitness",
            "lint",
            "measure",
            "test"
          ]
        }
      }
    }
  }
}
