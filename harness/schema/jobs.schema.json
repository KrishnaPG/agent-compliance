{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent job outputs (--json-schema of each orchestrator job)",
  "description": "One schema per agent job of bhorch: the job's output is $defs/<job>. The orchestrator inlines $ref before it hands a schema to the claude CLI and validates every job result against it (bhcore.validate). $defs/finding is the one of finding.schema.json, merged in by bhorch.job_schema.",
  "$defs": {
    "gap": {
      "type": "object",
      "required": [
        "kind",
        "summary",
        "tag",
        "evidence"
      ],
      "properties": {
        "kind": {
          "$ref": "gaps.schema.json#/$defs/gap/properties/kind"
        },
        "summary": {
          "type": "string"
        },
        "tag": {
          "enum": [
            "owner-decides",
            "fixable"
          ]
        },
        "area": {
          "type": "string"
        },
        "resolve_with": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "S1",
            "S2",
            "S3",
            "S4"
          ]
        },
        "proof": {
          "enum": [
            "reproduced",
            "trigger",
            "theoretical"
          ]
        },
        "impact": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule": {
          "type": "string"
        },
        "reopens": {
          "type": "string"
        },
        "answered_by": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "line"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "quote": {
                "type": "string"
              }
            }
          }
        },
        "looked_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gaps": {
      "type": "object",
      "required": [
        "gaps"
      ],
      "properties": {
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "added_items",
        "added_targets",
        "added_contracts",
        "not_derivable"
      ],
      "properties": {
        "added_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "added_targets": {
          "type": "integer"
        },
        "added_contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_derivable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "harvest_find": {
      "type": "object",
      "required": [
        "candidates"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "job",
              "ecosystem",
              "bricks",
              "evidence"
            ],
            "properties": {
              "job": {
                "type": "string"
              },
              "ecosystem": {
                "type": "string"
              },
              "bricks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pick": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "line"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer"
                    },
                    "quote": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "description": "Each summary teaches (QBC-53): what is wrong -> the right way, and how to prevent it.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/finding"
              },
              {
                "required": [
                  "severity",
                  "where"
                ],
                "properties": {
                  "summary": {
                    "pattern": "\\S.* -> \\S"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "test_author": {
      "type": "object",
      "required": [
        "acceptance",
        "test_code"
      ],
      "properties": {
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "test_code": {
          "type": "string",
          "minLength": 1,
          "description": "the complete acceptance test file in the project's own framework; the program writes it at verifier.acceptance_paths[0]"
        }
      }
    },
    "regression_row": {
      "$ref": "#/$defs/test_author"
    },
    "judge": {
      "type": "object",
      "description": "bh decide: a fresh agent's judgement of a decision record's options (field names: docs/atdd/fields.yaml, command decide).",
      "required": ["options", "recommended", "objections", "falsifying_calls"],
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "targets", "rules"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "targets": {"type": "array", "items": {"type": "string"}},
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "verdict"],
                  "additionalProperties": false,
                  "properties": {"id": {"type": "string"}, "verdict": {"enum": ["pass", "fail", "unknown"]}}
                }
              }
            }
          }
        },
        "recommended": {"type": "string"},
        "objections": {"type": "array", "items": {"type": "string"}},
        "falsifying_calls": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
