#!/usr/bin/env python3
"""A fake host CLI for the orchestrator tests: no model, no network, no cost.

Contract of ``--agents`` (https://code.claude.com/docs/en/cli-reference): a JSON object defining the agents, inline; with
``--print`` the value may instead be the path to a JSON file holding that object (Claude Code 2.1.281 and later). The docs
give no marker, so this stub tells them apart by the text: a value starting with ``{`` is the object, anything else a path.
(It never stats the value: a stat of a long JSON string raises ENAMETOOLONG on Python 3.12 and 3.13.) bhorch passes inline JSON.

It stands in for ``claude -p --agent ... --output-format json`` and behaves from a spec file
(``$FAKE_CLAUDE_SPEC``, JSON):

  outputs        agent name -> the structured output to return (the schema is not applied here;
                 the orchestrator validates it)
  auth_fail_bare true: a job in bare mode (``--bare``) fails with an authentication error
  hide_agents_bare true: bare mode ignores ``--agents`` (a host change): agent not found
  budget_overrun [agent, ...]: those agents end with the CLI's ``error_max_budget_usd`` result
  fail           [agent, ...]: those agents exit 1 with an error result
  cost, usage    cost (usd) and usage reported per job
  files          agent name -> {path relative to the job's cwd: text}: files the agent writes
  outputs_by_item agent name -> {item: structured output}: per item, read from the job's input file

Every call is appended to ``$FAKE_CLAUDE_LOG`` as one JSON line: argv, mode, agent, cwd, stdin.
"""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

argv = sys.argv[1:]
prompt = sys.stdin.read()
spec = json.loads(Path(os.environ["FAKE_CLAUDE_SPEC"]).read_text())
raw_agent = argv[argv.index("--agent") + 1] if "--agent" in argv else None
agent = raw_agent.split(":")[-1] if raw_agent else None
mode = "bare" if "--bare" in argv else "login"
with open(os.environ["FAKE_CLAUDE_LOG"], "a") as log:
    log.write(
        json.dumps(
            {"argv": argv, "mode": mode, "agent": agent, "cwd": os.getcwd(), "stdin": prompt}
        )
        + "\n"
    )


def agent_not_found():
    """The real CLI under ``--bare``: no plugin agents, only built-ins and ``--agents``."""
    defined = {}
    if "--agents" in argv and not spec.get("hide_agents_bare"):
        raw = argv[argv.index("--agents") + 1]
        # JSON or a file name, told apart by its text: a stat of a long JSON string raises ENAMETOOLONG on Python 3.12/3.13
        defined = json.loads(raw if raw.lstrip().startswith("{") else Path(raw).read_text())
    if raw_agent is not None and raw_agent not in defined:
        print(
            f"Error: --agent '{raw_agent}' not found. Available agents: "
            + ", ".join(["claude", "Explore", *defined]),
            file=sys.stderr,
        )
        sys.exit(1)


if mode == "bare":
    agent_not_found()


def result(**kw):
    base = {
        "type": "result",
        "subtype": "success",
        "is_error": False,
        "result": "",
        "total_cost_usd": spec.get("cost", 0.01),
        "usage": spec.get("usage", {"input_tokens": 10, "output_tokens": 5}),
        "duration_ms": 3,
        "num_turns": 1,
    }
    print(json.dumps({**base, **kw}))


if spec.get("auth_fail_bare") and mode == "bare":
    result(is_error=True, result="Invalid API key - Please run /login", total_cost_usd=0)
    sys.exit(1)
if agent in spec.get("budget_overrun", []):
    result(subtype="error_max_budget_usd", is_error=True, total_cost_usd=2.01)
    sys.exit(1)
if agent in spec.get("fail", []):
    result(is_error=True, result=spec.get("fail_text", "the model gave up"))
    sys.exit(1)

for rel, text in spec.get("files", {}).get(agent, {}).items():  # what the agent's Write tool would leave
    Path(rel).parent.mkdir(parents=True, exist_ok=True)
    Path(rel).write_text(text)
out = dict(spec.get("outputs", {}).get(agent, {}))
m = re.search(r"Input file \(read it first; it names every other path\): (\S+)", prompt)
item = json.loads(Path(m.group(1)).read_text()).get("item") if m else None
out = dict(spec.get("outputs_by_item", {}).get(agent, {}).get(item, out))
result(structured_output=out)
