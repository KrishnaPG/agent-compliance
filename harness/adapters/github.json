{
  "name": "github",
  "description": "GitHub Issues through gh 2.94.0 or later (sub-issues, issue types, blocked-by). The ready filter is a search query (open, unassigned, not blocked, of the asked type: Task for items, Bug for defect intake; change the query through config tracker.commands.ready for other types); no atomic claim, an assignee is a soft claim.",
  "types": {
    "goal": "Goal",
    "feature": "Feature",
    "item": "Task",
    "defect": "Bug"
  },
  "commands": {
    "ready": "gh issue list --state open --limit {limit} --search 'no:assignee -is:blocked type:{type}' --json number,title,body,state,assignees,issueType,parent,blockedBy",
    "show": "gh issue view {ref} --json number,title,body,state,assignees,issueType,parent,blockedBy",
    "list": "gh issue list --state open --limit {limit} --json number,title,body,state,assignees,issueType,parent,blockedBy",
    "claim": "gh issue edit {ref} --add-assignee @me",
    "close": "gh issue close {ref} --reason completed --comment {reason}",
    "reopen": "gh issue reopen {ref} --comment {reason}",
    "issues": "gh api --paginate -X GET repos/{repo}/issues -f state={state} -f per_page=100",
    "issue": "gh api repos/{repo}/issues/{ref}",
    "comments": "gh api --paginate repos/{repo}/issues/{ref}/comments",
    "comment": "gh api -X POST repos/{repo}/issues/{ref}/comments -f body={body}",
    "link_parent": "gh api -X POST repos/{repo}/issues/{parent}/sub_issues -F sub_issue_id={child_id}",
    "set_body": "gh api -X PATCH repos/{repo}/issues/{ref} -f body={body}"
  },
  "fields": {
    "ref": "number",
    "title": "title",
    "body": "body",
    "state": "state",
    "type": "issueType.name",
    "assignee": "assignees[].login",
    "parent": "parent.number",
    "deps": "blockedBy[].number"
  },
  "states": {
    "OPEN": "open",
    "CLOSED": "closed"
  },
  "missing": "(?i)could not resolve|not found|no issue",
  "release": "gh issue edit {ref} --remove-assignee @me",
  "id_prefix": "gh"
}
