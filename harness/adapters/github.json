{
  "name": "github",
  "description": "GitHub Issues through gh 2.94.0 or later (sub-issues, issue types, blocked-by). The ready filter is a search query (open, unassigned, not blocked, type Task: change the query through config tracker.commands.ready for other types); no atomic claim, an assignee is a soft claim.",
  "types": {
    "goal": "Goal",
    "feature": "Feature",
    "item": "Task"
  },
  "commands": {
    "ready": "gh issue list --state open --limit {limit} --search 'no:assignee -is:blocked type:Task' --json number,title,body,state,assignees,issueType,parent,blockedBy",
    "show": "gh issue view {ref} --json number,title,body,state,assignees,issueType,parent,blockedBy",
    "list": "gh issue list --state open --limit {limit} --json number,title,body,state,assignees,issueType,parent,blockedBy",
    "claim": "gh issue edit {ref} --add-assignee @me",
    "close": "gh issue close {ref} --reason completed --comment {reason}",
    "reopen": "gh issue reopen {ref} --comment {reason}"
  },
  "fields": {
    "ref": "number",
    "title": "title",
    "body": "body",
    "state": "state",
    "type": "issueType.name",
    "assignee": "assignees[].login",
    "parent": "parent.number",
    "deps": "blockedBy[].number"
  },
  "states": {
    "OPEN": "open",
    "CLOSED": "closed"
  },
  "missing": "(?i)could not resolve|not found|no issue",
  "release": "gh issue edit {ref} --remove-assignee @me",
  "id_prefix": "gh"
}
