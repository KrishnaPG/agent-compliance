{
  "name": "beads",
  "description": "Beads (bd) 1.3.4: one Dolt store with atomic claim (bd update --claim), hierarchy, typed dependencies and a native ready filter (bd ready). Goal, feature and item are epic, feature and task.",
  "pin": {
    "binary": "bd",
    "version": "1.3.4",
    "sha256": {
      "linux_amd64": "9185e9798ba044b288e781f7d57f28a48f558654e94572473e49991826e69930"
    }
  },
  "types": {
    "goal": "epic",
    "feature": "feature",
    "item": "task",
    "defect": "bug"
  },
  "commands": {
    "ready": "bd ready --json --brief -t {type} -n {limit} [--parent {parent}] --actor {actor}",
    "show": "bd show {ref} --json --brief-deps --actor {actor}",
    "list": "bd list --json --brief -n {limit} --status open,in_progress,blocked,deferred --actor {actor}",
    "claim": "bd update {ref} --claim --json --actor {actor}",
    "close": "bd close {ref} --reason {reason} --json --actor {actor}",
    "reopen": "bd reopen {ref} --reason {reason} --json --actor {actor}"
  },
  "fields": {
    "ref": "id",
    "title": "title",
    "body": "description",
    "state": "status",
    "type": "issue_type",
    "assignee": "assignee",
    "parent": "parent",
    "deps": "dependencies[type=blocks].depends_on_id"
  },
  "by_op": {
    "show": {
      "deps": "dependencies[dependency_type=blocks].id"
    }
  },
  "states": {
    "open": "open",
    "in_progress": "in_progress",
    "blocked": "open",
    "closed": "closed",
    "deferred": "deferred"
  },
  "missing": "(?i)no issue found|not found|does not exist",
  "release": "bd update {ref} --assignee \"\" --force",
  "id_prefix": "bd"
}
